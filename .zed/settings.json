{
    "lsp": {
        "rust-analyzer": {
            "initialization_options": {
                "cargo": {
                    "features": ["__lint"],
                    "allTargets": true
                },
                "check": {
                    "command": "clippy",
                    "allTargets": true,
                    "features": ["__lint"]
                }
            }
        }
    }
}
